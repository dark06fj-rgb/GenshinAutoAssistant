{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/genshin-ar-localization/entity.schema.json",
  "title": "Genshin Arabic Localization Entity",
  "type": "object",
  "required": [
    "id",
    "category",
    "source_name",
    "arabic_name",
    "translation_status",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "category": {
      "enum": [
        "character",
        "weapon",
        "artifact",
        "material",
        "resource",
        "region",
        "enemy",
        "food",
        "quest",
        "term"
      ]
    },
    "source_name": {
      "type": "string",
      "minLength": 1
    },
    "arabic_name": {
      "type": "string"
    },
    "description_source": {
      "type": "string"
    },
    "description_ar": {
      "type": "string"
    },
    "rarity": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 5
    },
    "element": {
      "type": [
        "string",
        "null"
      ]
    },
    "weapon_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "image_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "translation_status": {
      "enum": [
        "draft",
        "reviewed",
        "approved",
        "needs_context"
      ]
    },
    "review_notes": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "item_type": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
